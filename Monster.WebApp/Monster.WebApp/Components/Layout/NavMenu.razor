@using Monster.WebApp.Services.Auth
@using Monster.WebApp.Services.Board
@using Microsoft.Extensions.DependencyInjection
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<NavMenu> Logger
@rendermode InteractiveServer

<MudNavMenu Class="mud-width-full">
    <span class="nav-section-label mt-4 mb-2">Menu</span>

    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" IconColor="Color.Inherit">홈</MudNavLink>

    @if (_categories != null && _categories.Any())
    {
        <span class="nav-section-label mt-6 mb-2">Board</span>

        @foreach (var category in _categories)
        {
            <MudNavLink Href="@($"/board/{category.UrlSlug}")" Match="NavLinkMatch.Prefix" Icon="@Monster.WebApp.Shared.CategoryDisplayHelper.GetIcon(category.UrlSlug)" IconColor="Color.Inherit">@category.Name</MudNavLink>
        }
    }

    @if (_isAdmin || _isSubAdminOrHigher)
    {
        <span class="nav-section-label mt-6 mb-2">Admin</span>

        @if (_isAdmin)
        {
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Inherit">대시보드</MudNavLink>
        }
        <MudNavLink Href="/admin/reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Flag" IconColor="Color.Inherit">신고 관리</MudNavLink>
        @if (_isAdmin)
        {
            <MudNavLink Href="/admin/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Inherit">설정</MudNavLink>
        }
    }
</MudNavMenu>

@code {
    private bool _isAdmin = false;
    private bool _isSubAdminOrHigher = false;
    private List<Monster.WebApp.Models.Board.Category>? _categories;
    private bool _isLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isLoaded)
        {
            _isLoaded = true;
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            // 각 서비스 호출에 독립적인 scope 사용하여 DbContext 충돌 방지
            using (var scope = ScopeFactory.CreateScope())
            {
                var categoryService = scope.ServiceProvider.GetRequiredService<CategoryService>();
                _categories = await categoryService.GetAllActiveCategoriesAsync();
            }

            using (var scope = ScopeFactory.CreateScope())
            {
                var roleService = scope.ServiceProvider.GetRequiredService<RoleService>();
                _isAdmin = await roleService.IsAdminAsync();
                _isSubAdminOrHigher = await roleService.IsSubAdminOrHigherAsync();
            }
        }
        catch (Exception ex)
        {
            // 로드 실패 시 기본 메뉴(홈)만 표시 — 네비게이션 전체가 깨지지 않도록
            Logger.LogError(ex, "네비게이션 메뉴 데이터 로드 실패");
        }
    }
}
