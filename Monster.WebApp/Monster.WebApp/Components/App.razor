<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="_content/Spillgebees.Blazor.RichTextEditor/Spillgebees.Blazor.RichTextEditor.lib.module.css" rel="stylesheet" />
    @* ?v= 캐시 버스팅: UseStaticFiles 기본값은 Cache-Control 미전송 → 브라우저 휴리스틱 캐시로
       CSS 갱신이 전달되지 않는 문제 방지. 앱 재시작/재배포 시 버전이 바뀌어 자동 무효화 *@
    <link rel="stylesheet" href="app.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/layout.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/custom.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/account.css?v=@AssetVersion" />
    <link rel="stylesheet" href="Monster.WebApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/theme.js"></script>
    <script src="js/editor-media.js"></script>
</body>

</html>

@code {
    // 앱 시작 시 1회 고정 — 재시작/재배포마다 정적 자산 캐시 무효화
    private static readonly string AssetVersion = DateTime.UtcNow.Ticks.ToString();
}
