@page "/not-found"
@layout MainLayout
@inject NavigationManager NavigationManager

<PageTitle>페이지를 찾을 수 없습니다 - Monster.WebApp</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="auth-container">
        <div class="auth-header">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Warning" />
            <MudText Typo="Typo.h4" Class="mt-4">404</MudText>
            <MudText Typo="Typo.h6" Class="mt-2">페이지를 찾을 수 없습니다</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="margin-top: 8px;">
                요청하신 페이지가 존재하지 않거나 이동되었을 수 있습니다.
            </MudText>
        </div>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-4" Color="Color.Secondary">
            찾으시는 페이지가 삭제되었거나 URL이 잘못되었을 수 있습니다.
        </MudText>

        <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Href="/"
                       StartIcon="@Icons.Material.Filled.Home">
                홈으로
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="GoBack"
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                이전 페이지
            </MudButton>
        </MudStack>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
            도움이 필요하시면
            <MudLink Href="/board" Color="Color.Primary">게시판</MudLink>
            을 방문해보세요.
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private void GoBack()
    {
        NavigationManager.NavigateTo("javascript:history.back()");
    }
}
