@page "/notifications"
@using Microsoft.AspNetCore.Authorization
@using Monster.WebApp.Models.Board
@using Monster.WebApp.Services.Auth
@using Monster.WebApp.Services.Board
@using Monster.WebApp.Shared
@attribute [Authorize]
@inject AuthService AuthService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>알림 - Southmw</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.Notifications" Color="Color.Primary" />
            <MudText Typo="Typo.h5">알림</MudText>
        </MudStack>
        @if (_notifications?.Any(n => !n.IsRead) == true)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="MarkAllAsReadAsync">전체 읽음</MudButton>
        }
    </MudStack>

    @if (_isLoading)
    {
        <MudStack Spacing="2">
            @for (var i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="64px" />
            }
        </MudStack>
    }
    else if (_notifications == null || _notifications.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.NotificationsNone"
                    Title="알림이 없습니다"
                    Description="내 게시글에 댓글이 달리거나 내 댓글에 답글이 달리면 여기에 표시됩니다." />
    }
    else
    {
        <MudPaper Elevation="2" Class="content-card">
            <div class="post-list">
                @foreach (var notification in _notifications)
                {
                    <div class="post-list-item notification-item @(notification.IsRead ? "" : "notification-item-unread")"
                         @onclick="@(() => OpenNotificationAsync(notification))">
                        <div class="d-flex align-start gap-3 flex-1">
                            <MudIcon Icon="@(notification.Type == NotificationType.CommentOnPost ? Icons.Material.Outlined.Comment : Icons.Material.Outlined.Reply)"
                                     Size="Size.Small" Color="Color.Primary" Class="mt-1" />
                            <div class="flex-1">
                                <MudText Typo="Typo.body2">@GetMessage(notification)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="notification-item-title">@notification.Post.Title</MudText>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="flex-shrink-0">
                                @TimeDisplayHelper.ToRelative(notification.CreatedAt)
                            </MudText>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>

        @if (_totalPages > 1)
        {
            <div class="d-flex justify-center mt-4">
                <MudPagination Count="_totalPages" Selected="_page" SelectedChanged="OnPageChangedAsync" Color="Color.Primary" />
            </div>
        }
    }
</MudContainer>

@code {
    private const int PageSize = 20;

    private bool _isLoading = true;
    private int? _userId;
    private List<Notification>? _notifications;
    private int _page = 1;
    private int _totalPages;

    protected override async Task OnInitializedAsync()
    {
        _userId = AuthService.GetCurrentUserId();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId == null)
        {
            _isLoading = false;
            return;
        }

        _isLoading = true;
        var (notifications, totalCount) = await NotificationService.GetPagedAsync(_userId.Value, _page, PageSize);
        _notifications = notifications;
        _totalPages = (int)Math.Ceiling(totalCount / (double)PageSize);
        _isLoading = false;
    }

    private async Task OnPageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OpenNotificationAsync(Notification notification)
    {
        if (_userId != null && !notification.IsRead)
        {
            await NotificationService.MarkAsReadAsync(notification.Id, _userId.Value);
        }
        NavigationManager.NavigateTo($"/board/{notification.Post.Category.UrlSlug}/{notification.PostId}");
    }

    private async Task MarkAllAsReadAsync()
    {
        if (_userId == null)
            return;

        await NotificationService.MarkAllAsReadAsync(_userId.Value);
        if (_notifications != null)
        {
            foreach (var notification in _notifications)
                notification.IsRead = true;
        }
    }

    private static string GetMessage(Notification notification) => notification.Type switch
    {
        NotificationType.CommentOnPost => $"{notification.ActorNickname}님이 회원님의 게시글에 댓글을 남겼습니다.",
        NotificationType.ReplyToComment => $"{notification.ActorNickname}님이 회원님의 댓글에 답글을 남겼습니다.",
        _ => $"{notification.ActorNickname}님의 새 알림"
    };
}
