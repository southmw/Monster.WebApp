@page "/board"
@using Monster.WebApp.Shared
@inject CategoryService CategoryService
@rendermode InteractiveServer

<PageTitle>게시판 - Southmw</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4">게시판</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-1">
        원하는 게시판을 선택하세요
    </MudText>
</div>

@if (categories == null)
{
    <MudGrid Spacing="3">
        @for (var i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="rounded-lg" />
            </MudItem>
        }
    </MudGrid>
}
else if (categories.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.Forum"
                Title="개설된 게시판이 없습니다"
                Description="게시판이 준비되면 이곳에 표시됩니다." />
}
else
{
    <MudGrid Spacing="3">
        @foreach (var category in categories)
        {
            <MudItem xs="12" sm="6" md="4">
                <a class="category-card" href="@($"/board/{category.UrlSlug}")">
                    <div class="d-flex align-center mb-3">
                        <span class="category-icon mr-3">
                            <MudIcon Icon="@CategoryDisplayHelper.GetIcon(category.UrlSlug)" />
                        </span>
                        <MudText Typo="Typo.h6">@category.Name</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @category.Description
                    </MudText>
                </a>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Category>? categories;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryService.GetAllActiveCategoriesAsync();
    }
}
