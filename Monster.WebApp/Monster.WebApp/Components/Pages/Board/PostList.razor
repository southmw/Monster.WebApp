@page "/board/{categoryUrl}"
@using Monster.WebApp.Services
@using Monster.WebApp.Models
@inject CategoryService CategoryService
@inject PostService PostService
@inject CategoryAccessService CategoryAccessService
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<PostList> Logger
@rendermode InteractiveServer

@if (_isLoading)
{
    <MudSkeleton Width="220px" Height="40px" Class="mb-4" />
    <MudPaper Elevation="0" Class="post-list">
        @for (var i = 0; i < 8; i++)
        {
            <div class="pa-4">
                <MudSkeleton Width="@($"{85 - i * 4}%")" Height="20px" />
                <MudSkeleton Width="30%" Height="14px" Class="mt-1" />
            </div>
        }
    </MudPaper>
}
else if (_loadFailed)
{
    <EmptyState Icon="@Icons.Material.Outlined.ErrorOutline"
                Title="게시글 목록을 불러오지 못했습니다"
                Description="잠시 후 다시 시도해주세요."
                Severity="Severity.Error">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryLoadAsync" DropShadow="false">다시 시도</MudButton>
    </EmptyState>
}
else if (category == null)
{
    <EmptyState Icon="@Icons.Material.Outlined.Error"
                Title="게시판을 찾을 수 없습니다"
                Severity="Severity.Error">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/board" DropShadow="false">게시판 목록으로</MudButton>
    </EmptyState>
}
else if (!hasAccess)
{
    <EmptyState Icon="@Icons.Material.Outlined.Lock"
                Title="접근 권한이 없습니다"
                Description="이 게시판은 권한이 있는 사용자만 접근할 수 있습니다."
                Severity="Severity.Error">
        @if (!AuthService.IsAuthenticated())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/account/login" DropShadow="false">로그인하기</MudButton>
        }
    </EmptyState>
}
else
{
    <div class="post-header">
        <div>
            <MudText Typo="Typo.h4">@category.Name</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-1">
                @category.Description
            </MudText>
        </div>
        @if (canWrite)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Create"
                       Href="@($"/board/{CategoryUrl}/write")"
                       DropShadow="false">
                글쓰기
            </MudButton>
        }
    </div>

    <!-- 검색 영역 -->
    <div class="post-search-bar">
        @if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                     OnClose="ClearSearch" Style="margin: 0;">
                '@_searchQuery' @(totalCount)건
            </MudChip>
        }
        <MudTextField @bind-Value="_searchQuery" Variant="Variant.Outlined"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="Search" Margin="Margin.Dense"
                      OnKeyUp="@((e) => { if (e.Key == "Enter") Search(); })"
                      Placeholder="검색" Clearable="true" Class="post-search-field" />
    </div>

    @if (posts == null)
    {
        <div class="d-flex justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (posts.Count == 0)
    {
        @if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            <EmptyState Icon="@Icons.Material.Outlined.SearchOff"
                        Title="검색 결과가 없습니다"
                        Description="@($"'{_searchQuery}'에 해당하는 게시글을 찾지 못했습니다.")">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearSearch">검색 초기화</MudButton>
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="@Icons.Material.Outlined.Article"
                        Title="작성된 게시글이 없습니다"
                        Description="첫 번째 게시글을 작성해보세요!" />
        }
    }
    else
    {
        <MudPaper Elevation="0" Class="post-list">
            @foreach (var post in posts)
            {
                <a class="post-list-item @(post.IsPinned ? "post-list-item-pinned" : "")"
                   href="@($"/board/{CategoryUrl}/{post.Id}")">
                    <div class="post-list-main">
                        <div class="post-list-title-row">
                            @if (post.IsPinned)
                            {
                                <span class="post-pin-chip">공지</span>
                            }
                            <span class="post-list-title">@post.Title</span>
                        </div>
                        <div class="post-list-meta">
                            <span>@post.AuthorNickname</span>
                            <span class="post-meta-dot">·</span>
                            <span>@post.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                        </div>
                    </div>
                    <div class="post-list-stats">
                        <span class="post-stat" title="조회수">
                            <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />@post.ViewCount
                        </span>
                        <span class="post-stat" title="추천수">
                            <MudIcon Icon="@Icons.Material.Outlined.ThumbUp" Size="Size.Small" />@post.VoteCount
                        </span>
                    </div>
                </a>
            }
        </MudPaper>

        <!-- 페이징 영역 -->
        <div class="post-paging">
            <MudSelect T="int" Value="@pageSize" ValueChanged="OnPageSizeChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       Class="post-paging-size" Label="표시 개수">
                <MudSelectItem Value="10">10개</MudSelectItem>
                <MudSelectItem Value="20">20개</MudSelectItem>
                <MudSelectItem Value="50">50개</MudSelectItem>
                <MudSelectItem Value="100">100개</MudSelectItem>
            </MudSelect>
            <MudPagination Count="@((int)Math.Ceiling(totalCount / (double)pageSize))"
                           Selected="@currentPage"
                           SelectedChanged="OnPageChanged"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           Class="post-paging-pages" />
        </div>
    }
}

@code {
    [Parameter]
    public string CategoryUrl { get; set; } = string.Empty;

    // 페이지/페이지크기/검색어를 URL 쿼리로 보존 (뒤로가기/새로고침 시 상태 유지)
    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "size")]
    public int? PageSizeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private Category? category;
    private List<Post>? posts;
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 20;
    private bool hasAccess = false;
    private bool canWrite = false;
    private bool _isLoading = true;
    private bool _loadFailed = false;
    private string _searchQuery = string.Empty;

    private static readonly int[] AllowedPageSizes = { 10, 20, 50, 100 };

    protected override async Task OnParametersSetAsync()
    {
        currentPage = Page is > 0 ? Page.Value : 1;
        pageSize = PageSizeQuery != null && AllowedPageSizes.Contains(PageSizeQuery.Value) ? PageSizeQuery.Value : 20;
        _searchQuery = Query ?? string.Empty;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _loadFailed = false;
            category = await CategoryService.GetCategoryByUrlSlugAsync(CategoryUrl);

            if (category != null)
            {
                // Check access permissions
                hasAccess = await CategoryAccessService.CanAccessCategoryAsync(category.Id);

                if (!hasAccess)
                {
                    return;
                }

                // Check write permissions
                canWrite = await CategoryAccessService.CanWriteToCategoryAsync(category.Id);

                var result = await PostService.GetPostsByCategoryAsync(category.Id, currentPage, pageSize, _searchQuery);
                posts = result.Posts;
                totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "게시글 목록 로드 실패 (Category: {CategoryUrl})", CategoryUrl);
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RetryLoadAsync()
    {
        _isLoading = true;
        await LoadDataAsync();
    }

    /// <summary>현재 페이지/페이지크기/검색어를 쿼리스트링에 반영해 이동 (기본값은 생략)</summary>
    private void NavigateWithState()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(
            $"/board/{CategoryUrl}",
            new Dictionary<string, object?>
            {
                ["page"] = currentPage == 1 ? null : currentPage,
                ["size"] = pageSize == 20 ? null : pageSize,
                ["q"] = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery
            });
        NavigationManager.NavigateTo(uri);
    }

    private void OnPageChanged(int page)
    {
        currentPage = page;
        NavigateWithState();
    }

    private void OnPageSizeChanged(int size)
    {
        pageSize = size;
        currentPage = 1;
        NavigateWithState();
    }

    private void Search()
    {
        currentPage = 1;
        NavigateWithState();
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        currentPage = 1;
        NavigateWithState();
    }
}
