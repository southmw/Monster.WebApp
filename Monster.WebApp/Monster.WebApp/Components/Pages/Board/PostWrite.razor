@page "/board/{categoryUrl}/write"
@using Monster.WebApp.Services
@using Monster.WebApp.Models
@using Monster.WebApp.Shared
@inject CategoryService CategoryService
@inject PostService PostService
@inject CategoryAccessService CategoryAccessService
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@rendermode InteractiveServer

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (category == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (!canWrite)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Lock"
                    Title="글쓰기 권한이 없습니다"
                    Description="이 게시판은 권한이 있는 사용자만 글을 작성할 수 있습니다."
                    Severity="Severity.Error">
            @if (!AuthService.IsAuthenticated())
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/account/login" DropShadow="false">로그인하기</MudButton>
            }
        </EmptyState>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-6">
            <MudIcon Icon="@Icons.Material.Outlined.Create" Style="vertical-align: middle;" />
            글쓰기 - @category.Name
        </MudText>

        <div class="write-container">
            <div class="form-section">
                <MudTextField @bind-Value="title" Label="제목" Variant="Variant.Outlined"
                              Required="true" FullWidth="true" MaxLength="200"
                              Class="compact-input" Margin="Margin.Dense" />
            </div>

            @if (!isAuthenticated)
            {
                <MudGrid Spacing="1" Class="form-section">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="authorNickname" Label="작성자" Variant="Variant.Outlined"
                                      Required="true" MaxLength="50" FullWidth="false" Style="max-width: 250px;"
                                      Class="compact-input" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="password" Label="비밀번호" Variant="Variant.Outlined"
                                      Required="true" InputType="InputType.Password"
                                      HelperText="게시글 수정/삭제 시 필요합니다" FullWidth="false" Style="max-width: 250px;"
                                      Class="compact-input" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            }

            @* translate="no": Google 페이지 번역이 Quill의 DOM을 조작해 에디터/Blazor 렌더링이 깨지는 것 방지 *@
            <div class="form-section post-editor" translate="no">
                @if (_isInteractive)
                {
                    <RichTextEditor @ref="_editor"
                                    @bind-Content="content"
                                    Placeholder="내용을 입력하세요..."
                                    Theme="QuillTheme.Snow"
                                    EditorContainerHtmlId="post-editor"
                                    ToolbarOptions="@_toolbarOptions" />
                }
                else
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="364px" />
                }
            </div>

            <div class="form-section">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(isAuthenticated ? "이미지는 툴바의 이미지 버튼으로 업로드합니다 (최대 10MB, jpg/png/gif/webp). " : "")동영상은 툴바의 동영상 버튼으로 YouTube/Vimeo 링크를 입력해 첨부합니다. 외부 사이트 이미지를 붙여넣으면 저장 시 제거됩니다.
                </MudText>
            </div>

            @if (_isSubAdminOrHigher)
            {
                <div class="form-section">
                    <MudCheckBox @bind-Value="isPinned" Label="공지로 등록" Color="Color.Primary" />
                </div>
            }

            <MudButtonGroup Size="Size.Medium" Style="margin-top: 16px;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="SubmitPost" Disabled="isSubmitting"
                           StartIcon="@Icons.Material.Outlined.Send">
                    @(isSubmitting ? "등록 중..." : "등록")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           Href="@($"/board/{CategoryUrl}")"
                           StartIcon="@Icons.Material.Outlined.Cancel">
                    취소
                </MudButton>
            </MudButtonGroup>
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public string CategoryUrl { get; set; } = string.Empty;

    private Category? category;
    private string title = string.Empty;
    private string content = string.Empty;
    private string authorNickname = string.Empty;
    private string password = string.Empty;
    private bool isSubmitting = false;
    private bool canWrite = false;
    private bool isAuthenticated = false;
    private bool isPinned = false;
    private bool _isSubAdminOrHigher = false;
    private User? currentUser;
    private RichTextEditor? _editor;
    // 프리렌더링 중에는 에디터를 렌더링하지 않음 (정적 렌더 단계의 JS interop dispose 오류 방지)
    private bool _isInteractive = false;
    private bool _imageHandlerRegistered = false;

    // 새니타이저(ContentSanitizer) 화이트리스트와 정합 — Font/Size/Color/Align 금지.
    // 이미지 버튼: 로그인 사용자만, 기본 핸들러(base64 삽입)는 registerImageHandler가 업로드 방식으로 교체.
    // 동영상 버튼: Quill 기본 URL 임베드(링크 첨부) — 새니타이저가 YouTube/Vimeo 임베드만 허용
    private ToolbarOptions _toolbarOptions = new();

    protected override async Task OnInitializedAsync()
    {
        category = await CategoryService.GetCategoryByUrlSlugAsync(CategoryUrl);

        if (category == null)
        {
            NavigationManager.NavigateTo("/board");
            return;
        }

        // Check write permissions
        canWrite = await CategoryAccessService.CanWriteToCategoryAsync(category.Id);

        // Get current user info
        isAuthenticated = AuthService.IsAuthenticated();
        _isSubAdminOrHigher = AuthService.IsSubAdminOrHigher();
        if (isAuthenticated)
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser != null)
            {
                authorNickname = currentUser.DisplayName; // Pre-fill for authenticated users
            }
        }

        _toolbarOptions = new ToolbarOptions
        {
            ShowStyleControls = true,
            ShowHeaderControls = true,
            ShowListControls = true,
            ShowQuotationControls = true,
            ShowCodeBlockControls = true,
            ShowHypertextLinkControls = true,
            ShowInsertImageControls = isAuthenticated, // 이미지 업로드는 로그인 사용자 전용
            ShowEmbedVideoControls = true,             // 동영상은 링크 임베드 — 모든 작성자 허용
            ShowCleanFormattingControls = true
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // OnAfterRender는 인터랙티브 서킷에서만 실행됨 — 이 시점부터 에디터 렌더링
            _isInteractive = true;
            StateHasChanged();
            return;
        }

        // 에디터 렌더링 이후 1회: 툴바 이미지 버튼의 기본 핸들러(base64)를 서버 업로드로 교체
        if (_isInteractive && isAuthenticated && canWrite && !_imageHandlerRegistered)
        {
            _imageHandlerRegistered = true;
            await JS.InvokeVoidAsync("monsterEditor.registerImageHandler", "post-editor");
        }
    }

    private async Task SubmitPost()
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            Snackbar.Add("제목을 입력해주세요.", Severity.Warning);
            return;
        }

        if (title.Length > 200)
        {
            Snackbar.Add("제목은 200자 이내로 입력해주세요.", Severity.Warning);
            return;
        }

        // @bind-Content는 디바운스가 있어 마지막 입력이 유실될 수 있음 — 제출 시점에 직접 조회
        if (_editor != null)
        {
            content = await _editor.GetContentAsync();
        }

        if (HtmlContentHelper.IsEmptyHtml(content))
        {
            Snackbar.Add("내용을 입력해주세요.", Severity.Warning);
            return;
        }

        if (content.Length > AppConstants.ContentLimits.PostMaxLength)
        {
            Snackbar.Add($"본문이 너무 깁니다. (최대 {AppConstants.ContentLimits.PostMaxLength:N0}자)", Severity.Warning);
            return;
        }

        // Validate anonymous post fields
        if (!isAuthenticated)
        {
            if (string.IsNullOrWhiteSpace(authorNickname) || string.IsNullOrWhiteSpace(password))
            {
                Snackbar.Add("작성자와 비밀번호를 입력해주세요.", Severity.Warning);
                return;
            }
        }

        if (category == null)
        {
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            var post = new Post
            {
                CategoryId = category.Id,
                Title = title,
                Content = content,
                AuthorNickname = authorNickname,
                IsPinned = _isSubAdminOrHigher && isPinned,
                PinnedAt = (_isSubAdminOrHigher && isPinned) ? DateTime.UtcNow : null
            };

            // 로그인 사용자는 password를 null로 전달
            var passwordToUse = isAuthenticated ? null : password;
            var createdPost = await PostService.CreatePostAsync(post, passwordToUse);

            Snackbar.Add("게시글이 등록되었습니다.", Severity.Success);
            NavigationManager.NavigateTo($"/board/{CategoryUrl}/{createdPost.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"게시글 등록 중 오류가 발생했습니다: {ex.Message}", Severity.Error);
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
