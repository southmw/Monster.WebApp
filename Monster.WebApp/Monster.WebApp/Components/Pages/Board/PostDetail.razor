@page "/board/{categoryUrl}/{postId:int}"
@using Monster.WebApp.Services
@using Monster.WebApp.Services.Auth
@using Monster.WebApp.Models
@using Monster.WebApp.Shared
@inject CategoryService CategoryService
@inject PostService PostService
@inject CommentService CommentService
@inject AuthService AuthService
@inject CategoryAccessService CategoryAccessService
@inject PostEditVerificationState EditVerificationState
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<PostDetail> Logger
@inject IJSRuntime JS
@rendermode InteractiveServer

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (_isLoading)
    {
        <div class="post-content-section">
            <MudSkeleton Width="60%" Height="36px" />
            <MudSkeleton Width="40%" Height="18px" Class="mt-3 mb-6" />
            <MudSkeleton Width="100%" Height="18px" Class="my-2" />
            <MudSkeleton Width="90%" Height="18px" Class="my-2" />
            <MudSkeleton Width="75%" Height="18px" Class="my-2" />
        </div>
    }
    else if (_loadFailed)
    {
        <EmptyState Icon="@Icons.Material.Outlined.ErrorOutline"
                    Title="게시글을 불러오지 못했습니다"
                    Description="잠시 후 다시 시도해주세요."
                    Severity="Severity.Error">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryLoadAsync" DropShadow="false">다시 시도</MudButton>
        </EmptyState>
    }
    else if (post == null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Error"
                    Title="게시글을 찾을 수 없습니다"
                    Severity="Severity.Error">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/board/{CategoryUrl}")" DropShadow="false">목록으로</MudButton>
        </EmptyState>
    }
    else if (!hasAccess)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Lock"
                    Title="접근 권한이 없습니다"
                    Description="이 게시판은 권한이 있는 사용자만 접근할 수 있습니다."
                    Severity="Severity.Error">
            @if (!AuthService.IsAuthenticated())
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/account/login" DropShadow="false">로그인하기</MudButton>
            }
        </EmptyState>
    }
    else
    {
        <!-- 게시글 본문 -->
        <div class="post-content-section">
            <div class="post-title-row">
                @if (post.IsPinned)
                {
                    <span class="post-pin-chip">공지</span>
                }
                <MudText Typo="Typo.h4">@post.Title</MudText>
            </div>
            <div class="post-meta">
                <span class="post-meta-item">@post.AuthorNickname</span>
                <span class="post-meta-dot">·</span>
                <span class="post-meta-item">@post.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                <span class="post-meta-spacer"></span>
                <span class="post-stat" title="조회수">
                    <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />@post.ViewCount
                </span>
                <span class="post-stat" title="추천수">
                    <MudIcon Icon="@Icons.Material.Outlined.ThumbUp" Size="Size.Small" />@post.VoteCount
                </span>
            </div>
            <div class="post-html-content">
                @((MarkupString)HtmlContentHelper.ToDisplayHtml(post.Content, post.IsHtml))
            </div>
        </div>

        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="post-actions">
            <MudButtonGroup Variant="Variant.Outlined">
                <MudButton Color="Color.Success" OnClick="VotePost" StartIcon="@Icons.Material.Outlined.ThumbUp">추천</MudButton>
                <MudButton Color="Color.Primary" Href="@($"/board/{CategoryUrl}")" StartIcon="@Icons.Material.Outlined.List">목록</MudButton>
            </MudButtonGroup>
            @if (CanEditOrDelete())
            {
                <MudButtonGroup Variant="Variant.Outlined">
                    <MudButton Color="Color.Info" OnClick="EditPost" StartIcon="@Icons.Material.Outlined.Edit">수정</MudButton>
                    <MudButton Color="Color.Error" OnClick="DeletePost" StartIcon="@Icons.Material.Outlined.Delete">삭제</MudButton>
                </MudButtonGroup>
            }
            @if (_isSubAdminOrHigher)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="@(post.IsPinned ? Color.Warning : Color.Primary)"
                           OnClick="TogglePin"
                           StartIcon="@Icons.Material.Outlined.PushPin">
                    @(post.IsPinned ? "공지 해제" : "공지 등록")
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       OnClick="@(() => ShowReportDialog(null))"
                       StartIcon="@Icons.Material.Outlined.Flag">
                신고
            </MudButton>
        </MudStack>

        <!-- 댓글 섹션 -->
        <div class="comment-section">
            <div class="content-card-header px-0 pt-0">
                <MudIcon Icon="@Icons.Material.Outlined.Comment" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.h6">댓글 <span class="comment-count">@post.Comments.Count</span></MudText>
            </div>

            <div class="comment-form">
                <MudText Typo="Typo.subtitle1" Class="mb-3">댓글 작성</MudText>
                <MudGrid Spacing="1">
                    @if (!IsLoggedIn)
                    {
                        <MudItem xs="6" sm="6">
                            <MudTextField @bind-Value="commentNickname" Label="작성자" Variant="Variant.Outlined"
                                          MaxLength="50" FullWidth="true"
                                          Class="compact-input" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudTextField @bind-Value="commentPassword" Label="비밀번호" Variant="Variant.Outlined"
                                          InputType="InputType.Password" FullWidth="true"
                                          Class="compact-input" Margin="Margin.Dense" />
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <div class="comment-editor" translate="no">
                            @if (_isInteractive)
                            {
                                <RichTextEditor @ref="_commentEditor"
                                                @bind-Content="commentContent"
                                                Placeholder="댓글 내용을 입력하세요..."
                                                Theme="QuillTheme.Snow"
                                                EditorContainerHtmlId="comment-editor-main"
                                                ToolbarOptions="@_commentToolbarOptions" />
                            }
                            else
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="124px" />
                            }
                        </div>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(IsLoggedIn ? "이미지는 툴바 버튼으로 업로드합니다 (최대 10MB). " : "")동영상은 툴바 버튼으로 YouTube/Vimeo 링크를 첨부합니다.
                        </MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                                   OnClick="SubmitComment" Disabled="isSubmittingComment"
                                   StartIcon="@Icons.Material.Outlined.Send">
                            @(isSubmittingComment ? "등록 중..." : "댓글 등록")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </div>

            @foreach (var comment in post.Comments.Where(c => c.ParentCommentId == null))
            {
                <div class="comment-item">
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.body2" Style="font-weight: 600;">
                            @comment.AuthorNickname
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 400; margin-left: 8px;" Class="d-inline">
                                @comment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                        </MudText>
                        @if (editingCommentId != comment.Id)
                        {
                            <MudStack Row="true" Spacing="0">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                               Color="Color.Default" OnClick="@(() => StartEditComment(comment))" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="@(() => DeleteComment(comment))" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Flag" Size="Size.Small"
                                               Color="Color.Default" title="신고" OnClick="@(() => ShowReportDialog(comment.Id))" />
                            </MudStack>
                        }
                    </div>

                    @if (editingCommentId == comment.Id)
                    {
                        <div style="margin-top: 12px;">
                            <div class="comment-editor" translate="no">
                                <RichTextEditor @ref="_editCommentEditor"
                                                @bind-Content="editCommentContent"
                                                Placeholder="댓글 수정..."
                                                Theme="QuillTheme.Snow"
                                                EditorContainerHtmlId="comment-editor-edit"
                                                ToolbarOptions="@_commentToolbarOptions" />
                            </div>
                            <MudStack Row="true" Spacing="1" Class="mt-2">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveEditComment">저장</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                           OnClick="CancelEditComment">취소</MudButton>
                            </MudStack>
                        </div>
                    }
                    else
                    {
                        <div class="comment-html-content" style="margin-top: 12px; line-height: 1.6;">
                            @((MarkupString)HtmlContentHelper.ToDisplayHtml(comment.Content, comment.IsHtml))
                        </div>
                    }

                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="() => ShowReplyForm(comment.Id)" Style="margin-top: 8px;"
                               StartIcon="@Icons.Material.Outlined.Reply">
                        답글
                    </MudButton>

                    @if (replyToCommentId == comment.Id)
                    {
                        <div class="comment-reply">
                            <MudGrid Spacing="1">
                                @if (!IsLoggedIn)
                                {
                                    <MudItem xs="6" sm="3">
                                        <MudTextField @bind-Value="replyNickname" Label="작성자" Variant="Variant.Outlined"
                                                      MaxLength="50" FullWidth="true"
                                                      Class="compact-input" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudTextField @bind-Value="replyPassword" Label="비밀번호" Variant="Variant.Outlined"
                                                      InputType="InputType.Password" FullWidth="true"
                                                      Class="compact-input" Margin="Margin.Dense" />
                                    </MudItem>
                                }
                                <MudItem xs="12">
                                    <div class="comment-editor" translate="no">
                                        <RichTextEditor @ref="_replyEditor"
                                                        @bind-Content="replyContent"
                                                        Placeholder="답글 내용을 입력하세요..."
                                                        Theme="QuillTheme.Snow"
                                                        EditorContainerHtmlId="comment-editor-reply"
                                                        ToolbarOptions="@_commentToolbarOptions" />
                                    </div>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudButtonGroup Size="Size.Small">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                   OnClick="SubmitReply" Disabled="isSubmittingReply">
                                            @(isSubmittingReply ? "등록 중..." : "등록")
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                                   OnClick="CancelReply">
                                            취소
                                        </MudButton>
                                    </MudButtonGroup>
                                </MudItem>
                            </MudGrid>
                        </div>
                    }

                    @foreach (var reply in post.Comments.Where(c => c.ParentCommentId == comment.Id))
                    {
                        <div class="comment-reply">
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                    <MudIcon Icon="@Icons.Material.Outlined.SubdirectoryArrowRight" Size="Size.Small" Color="Color.Secondary" Style="vertical-align: middle;" />
                                    @reply.AuthorNickname
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 400; margin-left: 8px;" Class="d-inline">
                                        @reply.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    </MudText>
                                </MudText>
                                @if (editingCommentId != reply.Id)
                                {
                                    <MudStack Row="true" Spacing="0">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                                       Color="Color.Default" OnClick="@(() => StartEditComment(reply))" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => DeleteComment(reply))" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Flag" Size="Size.Small"
                                                       Color="Color.Default" title="신고" OnClick="@(() => ShowReportDialog(reply.Id))" />
                                    </MudStack>
                                }
                            </div>

                            @if (editingCommentId == reply.Id)
                            {
                                <div style="margin-top: 8px;">
                                    <div class="comment-editor" translate="no">
                                        <RichTextEditor @ref="_editCommentEditor"
                                                        @bind-Content="editCommentContent"
                                                        Placeholder="답글 수정..."
                                                        Theme="QuillTheme.Snow"
                                                        EditorContainerHtmlId="comment-editor-edit"
                                                        ToolbarOptions="@_commentToolbarOptions" />
                                    </div>
                                    <MudStack Row="true" Spacing="1" Class="mt-2">
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                   OnClick="SaveEditComment">저장</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                                   OnClick="CancelEditComment">취소</MudButton>
                                    </MudStack>
                                </div>
                            }
                            else
                            {
                                <div class="comment-html-content" style="margin-top: 8px; line-height: 1.6; font-size: 14px;">
                                    @((MarkupString)HtmlContentHelper.ToDisplayHtml(reply.Content, reply.IsHtml))
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public string CategoryUrl { get; set; } = string.Empty;

    [Parameter]
    public int PostId { get; set; }

    private Post? post;
    private int? _currentUserId;
    private bool _isAdmin = false;
    private bool _isSubAdminOrHigher = false;
    private bool _isLoading = true;
    private bool _loadFailed = false;
    private bool hasAccess = false;
    // 프리렌더링 중에는 댓글 에디터를 렌더링하지 않음 (정적 렌더 단계의 JS interop dispose 오류 방지)
    private bool _isInteractive = false;
    private bool IsLoggedIn => _currentUserId != null;

    // Comment fields
    private string commentNickname = string.Empty;
    private string commentPassword = string.Empty;
    private string commentContent = string.Empty;
    private bool isSubmittingComment = false;

    // Reply fields
    private int? replyToCommentId = null;
    private string replyNickname = string.Empty;
    private string replyPassword = string.Empty;
    private string replyContent = string.Empty;
    private bool isSubmittingReply = false;

    // Edit comment fields
    private int? editingCommentId = null;
    private string editCommentContent = string.Empty;
    private string? editCommentPassword = null;

    // Rich text editors (수정/답글 폼은 상태 변수로 동시에 1개만 렌더링되므로 @ref 충돌 없음)
    private RichTextEditor? _commentEditor;
    private RichTextEditor? _replyEditor;
    private RichTextEditor? _editCommentEditor;

    // 이미지 핸들러 등록 추적 — 답글/수정 폼은 열릴 때마다 새 Quill 인스턴스가 생기므로
    // ShowReplyForm/StartEditComment에서 리셋 후 OnAfterRenderAsync에서 재등록
    private bool _commentHandlerRegistered = false;
    private bool _replyHandlerRegistered = false;
    private bool _editHandlerRegistered = false;

    // 댓글용 축소 툴바 — 새니타이저 화이트리스트와 정합.
    // 이미지(로그인 전용)/동영상(링크 임베드) 버튼은 OnAfterRender에서 권한 확인 후 구성
    private ToolbarOptions _commentToolbarOptions = new()
    {
        ShowStyleControls = true,
        ShowListControls = true,
        ShowHypertextLinkControls = true
    };

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = AuthService.GetCurrentUserId();
        _isAdmin = AuthService.IsAdmin();
        _isSubAdminOrHigher = AuthService.IsSubAdminOrHigher();
        await LoadPostAsync(incrementViewCount: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // OnAfterRender는 인터랙티브 서킷에서만 실행됨 — 이 시점부터 댓글 에디터 렌더링
            _isInteractive = true;

            // Prerendering 후 클라이언트에서 권한 재확인
            _currentUserId = AuthService.GetCurrentUserId();
            _isAdmin = AuthService.IsAdmin();
            _isSubAdminOrHigher = AuthService.IsSubAdminOrHigher();

            // 권한 확정 후 댓글 툴바 구성 — 이미지 업로드는 로그인 전용, 동영상은 링크 임베드(전체 허용)
            _commentToolbarOptions = new ToolbarOptions
            {
                ShowStyleControls = true,
                ShowListControls = true,
                ShowHypertextLinkControls = true,
                ShowInsertImageControls = IsLoggedIn,
                ShowEmbedVideoControls = true
            };

            StateHasChanged();
            return;
        }

        // 에디터 렌더링 이후: 툴바 이미지 버튼의 기본 핸들러(base64)를 서버 업로드로 교체.
        // 답글/수정 폼은 열릴 때마다 새 인스턴스이므로 플래그 리셋 후 재등록된다.
        if (!_isInteractive || !IsLoggedIn)
            return;

        if (!_commentHandlerRegistered)
        {
            _commentHandlerRegistered = true;
            await JS.InvokeVoidAsync("monsterEditor.registerImageHandler", "comment-editor-main");
        }

        if (replyToCommentId != null && !_replyHandlerRegistered)
        {
            _replyHandlerRegistered = true;
            await JS.InvokeVoidAsync("monsterEditor.registerImageHandler", "comment-editor-reply");
        }

        if (editingCommentId != null && !_editHandlerRegistered)
        {
            _editHandlerRegistered = true;
            await JS.InvokeVoidAsync("monsterEditor.registerImageHandler", "comment-editor-edit");
        }
    }

    private bool CanEditOrDelete()
    {
        if (post == null) return false;

        // 관리자는 모든 게시글 수정/삭제 가능
        if (_isAdmin) return true;

        // 익명 게시글은 항상 수정/삭제 버튼 표시 (비밀번호로 확인)
        if (post.UserId == null) return true;

        // 로그인한 사용자의 본인 게시글
        if (_currentUserId != null && post.UserId == _currentUserId) return true;

        return false;
    }

    private async Task EditPost()
    {
        if (post == null) return;

        // 익명 게시글인 경우 비밀번호 확인
        if (post.UserId == null)
        {
            var password = await ShowPasswordDialog("게시글 수정", "게시글 작성 시 입력한 비밀번호를 입력해주세요.");
            if (string.IsNullOrEmpty(password)) return;

            // 비밀번호는 URL에 노출하지 않고 서킷 범위 상태로 전달 (PostEdit에서 1회 소비·검증)
            EditVerificationState.Set(PostId, password);
            NavigationManager.NavigateTo($"/board/{CategoryUrl}/{PostId}/edit");
        }
        else
        {
            // 로그인 사용자 게시글
            NavigationManager.NavigateTo($"/board/{CategoryUrl}/{PostId}/edit");
        }
    }

    private async Task DeletePost()
    {
        if (post == null) return;

        string? password = null;

        // 관리자가 아니고 익명 게시글인 경우 비밀번호 확인
        if (!_isAdmin && post.UserId == null)
        {
            password = await ShowPasswordDialog("게시글 삭제", "게시글 작성 시 입력한 비밀번호를 입력해주세요.");
            if (string.IsNullOrEmpty(password)) return;
        }

        // 삭제 확인 다이얼로그
        var confirmed = await DialogService.ShowMessageBox(
            "게시글 삭제",
            "정말로 이 게시글을 삭제하시겠습니까?",
            yesText: "삭제",
            cancelText: "취소"
        );

        if (confirmed == true)
        {
            var success = await PostService.DeletePostAsync(PostId, password);
            if (success)
            {
                Snackbar.Add("게시글이 삭제되었습니다.", Severity.Success);
                NavigationManager.NavigateTo($"/board/{CategoryUrl}");
            }
            else
            {
                Snackbar.Add("게시글 삭제에 실패했습니다. 비밀번호를 확인해주세요.", Severity.Error);
            }
        }
    }

    /// <param name="commentId">null이면 게시글 신고, 값이 있으면 해당 댓글 신고</param>
    private async Task ShowReportDialog(int? commentId)
    {
        var parameters = new DialogParameters<ReportDialog>
        {
            { x => x.PostId, PostId },
            { x => x.CommentId, commentId }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<ReportDialog>("신고", parameters, options);
    }

    private async Task<string?> ShowPasswordDialog(string title, string message)
    {
        var parameters = new DialogParameters<PasswordDialog>
        {
            { x => x.Title, title },
            { x => x.Message, message }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<PasswordDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is string password)
        {
            return password;
        }

        return null;
    }

    /// <param name="incrementViewCount">
    /// 페이지 최초 로드에서만 true — 댓글/추천 후 새로고침에서 중복 카운트되지 않도록
    /// </param>
    private async Task LoadPostAsync(bool incrementViewCount = false)
    {
        try
        {
            _loadFailed = false;
            post = await PostService.GetPostByIdAsync(PostId);

            if (post != null)
            {
                // 카테고리 접근 권한 검증 (URL 직접 입력으로 비공개 게시판 우회 차단)
                hasAccess = await CategoryAccessService.CanAccessCategoryAsync(post.CategoryId);

                if (hasAccess && incrementViewCount)
                {
                    await PostService.IncrementViewCountAsync(PostId);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "게시글 로드 실패 (PostId: {PostId})", PostId);
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RetryLoadAsync()
    {
        _isLoading = true;
        await LoadPostAsync(incrementViewCount: true);
    }

    private async Task VotePost()
    {
        var (success, message) = await PostService.VotePostAsync(PostId);
        if (success)
        {
            await LoadPostAsync();
            Snackbar.Add("추천되었습니다.", Severity.Success);
        }
        else
        {
            Snackbar.Add(message, Severity.Warning);
        }
    }

    private async Task SubmitComment()
    {
        // @bind-Content 디바운스로 인한 마지막 입력 유실 방지 — 제출 시점에 직접 조회
        if (_commentEditor != null)
        {
            commentContent = await _commentEditor.GetContentAsync();
        }

        if (HtmlContentHelper.IsEmptyHtml(commentContent))
        {
            Snackbar.Add("댓글 내용을 입력해주세요.", Severity.Warning);
            return;
        }

        if (commentContent.Length > AppConstants.ContentLimits.CommentMaxLength)
        {
            Snackbar.Add($"댓글이 너무 깁니다. (최대 {AppConstants.ContentLimits.CommentMaxLength:N0}자)", Severity.Warning);
            return;
        }

        // 비로그인 사용자는 닉네임/비밀번호 필수
        if (!IsLoggedIn && (string.IsNullOrWhiteSpace(commentNickname) || string.IsNullOrWhiteSpace(commentPassword)))
        {
            Snackbar.Add("작성자와 비밀번호를 입력해주세요.", Severity.Warning);
            return;
        }

        isSubmittingComment = true;

        try
        {
            var comment = new Comment
            {
                PostId = PostId,
                Content = commentContent,
                UserId = _currentUserId,
                AuthorNickname = IsLoggedIn ? AuthService.GetCurrentUserDisplayName() ?? "사용자" : commentNickname
            };

            await CommentService.CreateCommentAsync(comment, IsLoggedIn ? null : commentPassword);

            Snackbar.Add("댓글이 등록되었습니다.", Severity.Success);
            // 에디터 내부 상태 초기화를 위해 전체 새로고침 (댓글 수정/삭제와 동일 패턴)
            NavigationManager.NavigateTo($"/board/{CategoryUrl}/{PostId}", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"댓글 등록 중 오류가 발생했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmittingComment = false;
        }
    }

