@page "/"
@using Monster.WebApp.Services.Board
@using Monster.WebApp.Models.Board
@using Monster.WebApp.Shared
@inject CategoryService CategoryService
@inject PostService PostService
@rendermode InteractiveServer

<PageTitle>홈 - Southmw</PageTitle>

@if (_isLoading)
{
    <!-- 스켈레톤 로딩: 실제 레이아웃과 동일한 골격 표시 -->
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" Class="rounded-xl mb-6" />
    <MudPaper Elevation="0" Class="content-card pa-4">
        <MudSkeleton Width="35%" Height="32px" Class="mb-3" />
        @for (var j = 0; j < 6; j++)
        {
            <MudSkeleton Width="@($"{92 - j * 6}%")" Height="20px" Class="my-3" />
        }
    </MudPaper>
}
else
{
    <!-- Hero Section -->
    <section class="home-hero mb-6">
        <div class="home-hero-content">
            <MudText Typo="Typo.h4" Class="home-hero-title">환영합니다<span class="app-brand-dot">.</span></MudText>
            <MudText Typo="Typo.body1" Class="home-hero-subtitle mt-2">
                자유롭게 소통하고 정보를 공유하는 커뮤니티입니다.
            </MudText>
            <AuthorizeView>
                <NotAuthorized>
                    <MudStack Row="true" Spacing="2" Class="mt-5">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/account/register" DropShadow="false">시작하기</MudButton>
                        <MudButton Variant="Variant.Outlined" Class="home-hero-outline-btn" Href="/account/login">로그인</MudButton>
                    </MudStack>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>

    <!-- Main Content Grid -->
    <MudGrid Spacing="3">
        <!-- 최근/인기 피드 (탭 통합 카드) -->
        <MudItem xs="12">
            <MudPaper Elevation="0" Class="content-card">
                <div class="home-feed-header">
                    <div class="home-feed-tabs" role="tablist">
                        <button type="button" role="tab" aria-selected="@(_activeTab == FeedTab.Recent)"
                                class="home-feed-tab @(_activeTab == FeedTab.Recent ? "home-feed-tab-active" : "")"
                                @onclick="() => _activeTab = FeedTab.Recent">
                            최근 게시글
                        </button>
                        <button type="button" role="tab" aria-selected="@(_activeTab == FeedTab.Popular)"
                                class="home-feed-tab @(_activeTab == FeedTab.Popular ? "home-feed-tab-active" : "")"
                                @onclick="() => _activeTab = FeedTab.Popular">
                            인기 게시글
                        </button>
                    </div>
                    <a class="home-feed-more" href="/board">더보기 ›</a>
                </div>

                @{ var feedPosts = _activeTab == FeedTab.Recent ? _recentPosts : _popularPosts; }
                @if (feedPosts.Any())
                {
                    <div class="home-post-list">
                        @{ var rank = 1; }
                        @foreach (var post in feedPosts)
                        {
                            <a class="home-post-item" href="@($"/board/{post.Category.UrlSlug}/{post.Id}")">
                                @if (_activeTab == FeedTab.Popular)
                                {
                                    <span class="home-post-rank">@(rank++)</span>
                                }
                                <div class="home-post-text">
                                    <span class="home-post-title">@post.Title</span>
                                    <span class="home-post-meta">
                                        <span class="home-post-category">@post.Category.Name</span>
                                        <span>@post.AuthorNickname</span>
                                        <span class="post-meta-dot">·</span>
                                        <span>@TimeDisplayHelper.ToRelative(post.CreatedAt)</span>
                                    </span>
                                </div>
                                @if (_activeTab == FeedTab.Recent)
                                {
                                    <span class="home-post-stat">
                                        <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />@post.ViewCount
                                    </span>
                                }
                                else
                                {
                                    <span class="home-post-stat">
                                        <MudIcon Icon="@Icons.Material.Outlined.ThumbUp" Size="Size.Small" />@post.VoteCount
                                    </span>
                                }
                            </a>
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center py-8">
                        아직 게시글이 없습니다.
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        <!-- Category Cards -->
        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-3">게시판 바로가기</MudText>
            <MudGrid Spacing="2">
                @foreach (var category in _categories)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <a class="category-card category-card-compact" href="@($"/board/{category.UrlSlug}")">
                            <span class="category-icon">
                                <MudIcon Icon="@CategoryDisplayHelper.GetIcon(category.UrlSlug)" />
                            </span>
                            <span class="category-card-name">@category.Name</span>
                            <span class="category-card-count">@(category.Posts?.Count(p => !p.IsDeleted) ?? 0)개의 게시글</span>
                        </a>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
    </MudGrid>
}

@code {
    private enum FeedTab { Recent, Popular }

    private bool _isLoading = true;
    private FeedTab _activeTab = FeedTab.Recent;
    private List<Category> _categories = new();
    private List<Post> _recentPosts = new();
    private List<Post> _popularPosts = new();

    protected override async Task OnInitializedAsync()
    {
        // 순차적으로 호출하여 DbContext 동시 접근 방지
        _categories = await CategoryService.GetAllCategoriesAsync();
        _recentPosts = await PostService.GetRecentPostsAsync(8);
        _popularPosts = await PostService.GetPopularPostsAsync(8);

        _isLoading = false;
    }
}
