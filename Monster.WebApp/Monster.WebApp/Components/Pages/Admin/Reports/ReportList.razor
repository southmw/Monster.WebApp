@page "/admin/reports"
@using Microsoft.AspNetCore.Authorization
@using Monster.WebApp.Models.Board
@using Monster.WebApp.Services.Board
@using Monster.WebApp.Shared
@attribute [Authorize(Policy = AppConstants.Policies.SubAdminOrHigher)]
@inject ReportService ReportService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>신고 관리 - Southmw</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.Flag" Color="Color.Primary" />
            <MudText Typo="Typo.h5">신고 관리</MudText>
        </MudStack>
        <MudSelect T="ReportStatus?" Value="_statusFilter" ValueChanged="OnFilterChangedAsync"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width: 160px;">
            <MudSelectItem T="ReportStatus?" Value="@((ReportStatus?)null)">전체</MudSelectItem>
            <MudSelectItem T="ReportStatus?" Value="@((ReportStatus?)ReportStatus.Pending)">대기</MudSelectItem>
            <MudSelectItem T="ReportStatus?" Value="@((ReportStatus?)ReportStatus.Resolved)">처리됨</MudSelectItem>
            <MudSelectItem T="ReportStatus?" Value="@((ReportStatus?)ReportStatus.Dismissed)">기각됨</MudSelectItem>
        </MudSelect>
    </MudStack>

    @if (_isLoading)
    {
        <MudStack Spacing="2">
            @for (var i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
            }
        </MudStack>
    }
    else if (_reports == null || _reports.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.FlagCircle"
                    Title="신고 내역이 없습니다"
                    Description="@(_statusFilter == null ? "접수된 신고가 없습니다." : "해당 상태의 신고가 없습니다.")" />
    }
    else
    {
        <MudPaper Elevation="2" Class="content-card">
            <MudTable Items="_reports" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>대상</MudTh>
                    <MudTh>사유</MudTh>
                    <MudTh>신고자</MudTh>
                    <MudTh>접수일</MudTh>
                    <MudTh>상태</MudTh>
                    <MudTh Style="text-align: right;">액션</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="대상">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.CommentId == null ? Color.Primary : Color.Secondary)"
                                         Variant="Variant.Text">
                                    @(context.CommentId == null ? "게시글" : "댓글")
                                </MudChip>
                                <MudLink Href="@($"/board/{context.Post.Category.UrlSlug}/{context.PostId}")" Typo="Typo.body2">
                                    @Truncate(context.Post.Title, 40)
                                </MudLink>
                            </MudStack>
                            @if (context.Comment != null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @Truncate(ContentSanitizer.ToPlainText(context.Comment.Content), 60)
                                </MudText>
                            }
                            @if (!string.IsNullOrEmpty(context.Detail))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">상세: @Truncate(context.Detail, 60)</MudText>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="사유">@GetReasonText(context.Reason)</MudTd>
                    <MudTd DataLabel="신고자">
                        @(context.ReporterUser?.DisplayName ?? $"익명 ({context.ReporterIp})")
                    </MudTd>
                    <MudTd DataLabel="접수일">@TimeDisplayHelper.ToRelative(context.CreatedAt)</MudTd>
                    <MudTd DataLabel="상태">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Text">
                            @GetStatusText(context.Status)
                        </MudChip>
                        @if (context.Status != ReportStatus.Pending && context.ResolvedByNickname != null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @context.ResolvedByNickname
                                @if (!string.IsNullOrEmpty(context.ResolutionNote))
                                {
                                    <span> — @Truncate(context.ResolutionNote, 40)</span>
                                }
                            </MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="액션" Style="text-align: right;">
                        @if (context.Status == ReportStatus.Pending)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" Color="Color.Primary"
                                           title="처리" OnClick="@(() => ShowResolveDialogAsync(context, isDismiss: false))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Block" Size="Size.Small" Color="Color.Default"
                                           title="기각" OnClick="@(() => ShowResolveDialogAsync(context, isDismiss: true))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        @if (_totalPages > 1)
        {
            <div class="d-flex justify-center mt-4">
                <MudPagination Count="_totalPages" Selected="_page" SelectedChanged="OnPageChangedAsync" Color="Color.Primary" />
            </div>
        }
    }
</MudContainer>

@code {
    private const int PageSize = 20;

    private bool _isLoading = true;
    private List<Report>? _reports;
    private ReportStatus? _statusFilter = ReportStatus.Pending;
    private int _page = 1;
    private int _totalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        var (reports, totalCount) = await ReportService.GetReportsAsync(_statusFilter, _page, PageSize);
        _reports = reports;
        _totalPages = (int)Math.Ceiling(totalCount / (double)PageSize);
        _isLoading = false;
    }

    private async Task OnFilterChangedAsync(ReportStatus? status)
    {
        _statusFilter = status;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task ShowResolveDialogAsync(Report report, bool isDismiss)
    {
        var parameters = new DialogParameters<ResolveReportDialog>
        {
            { x => x.IsDismiss, isDismiss }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ResolveReportDialog>(isDismiss ? "신고 기각" : "신고 처리", parameters, options);
        var result = await dialog.Result;

        if (result == null || result.Canceled || result.Data is not ValueTuple<bool, string?> data)
            return;
        var (deleteContent, note) = data;

        var (success, message) = isDismiss
            ? await ReportService.DismissAsync(report.Id, note)
            : await ReportService.ResolveAsync(report.Id, deleteContent, note);

        Snackbar.Add(message, success ? Severity.Success : Severity.Error);
        if (success)
        {
            await LoadAsync();
        }
    }

    private static string Truncate(string text, int maxLength)
        => text.Length <= maxLength ? text : text[..maxLength] + "…";

    private static string GetReasonText(ReportReason reason) => reason switch
    {
        ReportReason.Spam => "스팸/광고",
        ReportReason.Abuse => "욕설/비방",
        ReportReason.Adult => "음란물/유해",
        ReportReason.Privacy => "개인정보 노출",
        _ => "기타"
    };

    private static string GetStatusText(ReportStatus status) => status switch
    {
        ReportStatus.Pending => "대기",
        ReportStatus.Resolved => "처리됨",
        _ => "기각됨"
    };

    private static Color GetStatusColor(ReportStatus status) => status switch
    {
        ReportStatus.Pending => Color.Warning,
        ReportStatus.Resolved => Color.Success,
        _ => Color.Default
    };
}
